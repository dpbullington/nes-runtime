<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NesRuntime.Maui.MainPage"
             BackgroundColor="Black">

    <Grid RowDefinitions="*,Auto,Auto,Auto,Auto" Padding="0">

        <!-- The game screen (SkiaSharp canvas) is inserted here in code-behind. It fills this row,
             which takes all remaining height (*), so the picture scales with the window size. -->
        <ContentView x:Name="ScreenHost" Grid.Row="0" />

        <Label x:Name="StatusLabel"
               Grid.Row="1"
               Margin="12,6,12,0"
               FontSize="12"
               TextColor="#B0B0B0"
               HorizontalTextAlignment="Center"
               Text="Idle." />

        <!-- Live frames-per-second, at the bottom of the game screen by the controller info. -->
        <Label x:Name="FpsLabel"
               Grid.Row="2"
               Margin="12,2,12,0"
               FontSize="13"
               FontFamily="Monospace"
               TextColor="#40D060"
               HorizontalTextAlignment="Center"
               Text="— FPS" />

        <!-- Controller connection status, refreshed by a timer in code-behind. -->
        <Label x:Name="ControllerStatusLabel"
               Grid.Row="3"
               Margin="12,2,12,6"
               FontSize="12"
               TextColor="#8090A0"
               HorizontalTextAlignment="Center"
               Text="" />

        <!-- On-screen controls are generated in code-behind and placed here. -->
        <ContentView x:Name="ControlsHost" Grid.Row="4" Margin="12" />

    </Grid>

</ContentPage>
