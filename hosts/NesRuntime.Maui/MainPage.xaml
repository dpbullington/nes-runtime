<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NesRuntime.Maui.MainPage"
             BackgroundColor="Black">

    <Grid RowDefinitions="*,Auto,Auto" Padding="0">

        <!-- The game screen (SkiaSharp canvas) is inserted here in code-behind. -->
        <ContentView x:Name="ScreenHost" Grid.Row="0" />

        <Label x:Name="StatusLabel"
               Grid.Row="1"
               Margin="12,6"
               FontSize="12"
               TextColor="#B0B0B0"
               HorizontalTextAlignment="Center"
               Text="Idle." />

        <!-- On-screen controls are generated in code-behind and placed here. -->
        <ContentView x:Name="ControlsHost" Grid.Row="2" Margin="12" />

    </Grid>

</ContentPage>
